---
import './Nav.css';
import LanguageSelect from './LanguageSelect.astro';
import type { LocaleData } from '../../lib/types';

interface Props {
  current: LocaleData;
  locales: LocaleData[];
}

const { current, locales } = Astro.props;
---

<section class="b-e-1">
  <div class="nav-cont">
    <div class="nav-title-cont">
      <h3 class="text-2">mathi3u.com</h3>
    </div>
    <div class="nav-language-cont">
      <LanguageSelect current={current} locales={locales} />
    </div>
  </div>
</section>
