---
// Ordre des feuilles de style identique à l'ancienne app CRA
// (index.css, puis reset.css, puis App.css, puis CSS des composants).
import '../styles/index.css';
import '../styles/reset.css';
import '../styles/App.css';
import '@fortawesome/fontawesome-svg-core/styles.css';
import { Font } from 'astro:assets';
import type { Alternate } from '../lib/seo';

interface Props {
  /** Code de langue de la page (attribut lang de <html>). */
  lang: string;
  title: string;
  description: string;
  /** Texte alternatif de l'image de partage. */
  imageAlt: string;
  /** Locale Open Graph de la page (ex. fr_FR) et celles des autres langues. */
  ogLocale: string;
  ogLocaleAlternates?: string[];
  /** Versions de la page dans les autres langues (hreflang). */
  alternates?: Alternate[];
  /** Données structurées schema.org. */
  jsonLd?: Record<string, unknown>;
  /** Page à exclure des moteurs de recherche (ex. 404). */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  imageAlt,
  ogLocale,
  ogLocaleAlternates = [],
  alternates = [],
  jsonLd,
  noindex = false,
} = Astro.props;

// URL absolue de la page courante : chaque langue est sa propre URL canonique.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
// JSON sûr dans une balise <script> (aucune séquence « </script> » possible).
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <Font cssVariable="--font-parkinsans" preload />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={pageUrl} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}

    <meta name="theme-color" content="#f1f2f6" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Open Graph / partage sur les réseaux sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="mathi3u.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((locale) => <meta property="og:locale:alternate" content={locale} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLdText && <script type="application/ld+json" is:inline set:html={jsonLdText} />}
  </head>
  <body>
    <slot />
  </body>
</html>
