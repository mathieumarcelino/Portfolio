# URL de l'API Strapi interrogée au build
STRAPI_URL=http://localhost:1337
# Token API Strapi en lecture seule (optionnel si le rôle Public a les droits)
STRAPI_TOKEN=
# URL publique des médias si elle diffère de STRAPI_URL (optionnel)
STRAPI_MEDIA_URL=

# Rebuild automatique à la publication Strapi (voir deploy/README.md)
# Secret partagé avec le webhook Strapi : openssl rand -hex 32
WEBHOOK_SECRET=
# Délai de regroupement des publications, en secondes (optionnel, 30 par défaut)
# REBUILD_DEBOUNCE_SECONDS=30
